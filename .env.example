# Shopify Storefront API (Tokens Oficiales en Vivo)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="tu-tienda.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="tu_storefront_public_token"
SHOPIFY_PRIVATE_STOREFRONT_ACCESS_TOKEN="shpat_tu_storefront_private_token"
SHOPIFY_API_VERSION="2026-07"

# Shopify Admin API (Fase 4 — pestaña Clientes del Admin Dashboard)
# Distinta de la Storefront API de arriba: se genera en Shopify Admin >
# Apps y canales de venta > Desarrollo de apps > [crear app] > Configurar
# Admin API (scopes read_customers + read_orders) > Instalar app > API
# credentials > "Admin API access token". El dominio SIEMPRE es el
# *.myshopify.com de la tienda, NO el dominio personalizado de arriba.
SHOPIFY_ADMIN_API_STORE_DOMAIN="tu-tienda.myshopify.com"
SHOPIFY_ADMIN_API_ACCESS_TOKEN="shpat_tu_admin_api_token"

# Panel de administrador (/admin/*)
ADMIN_EMAIL="admin@tu-tienda.com"          # admin raíz — login con contraseña propia
ADMIN_PASSWORD="cambia-esto"
# OBLIGATORIA en producción desde la Fase 1 de la auditoría — sin esto, el
# servidor rechaza firmar/verificar sesiones de admin en vez de caer a un
# secreto de desarrollo inseguro (ver src/lib/session.ts).
ADMIN_SESSION_SECRET="genera-un-secreto-largo-y-aleatorio"
# Correos ADICIONALES con acceso de admin, separados por comas. Cada uno
# entra con SU cuenta de cliente normal (no una contraseña de admin aparte)
# — debe existir ya en /auth/register. Ver src/lib/admin-access.ts.
ADMIN_EMAILS="otro-admin@tu-tienda.com,tercer-admin@tu-tienda.com"
# Opcional — si no se configura, el ticket de verificación de WhatsApp
# (src/lib/otp.ts) usa ADMIN_SESSION_SECRET como respaldo. Solo hace falta
# si quieres que ambos secretos sean independientes.
OTP_SESSION_SECRET=""

# WhatsApp Business API Config
WHATSAPP_API_TOKEN="tu_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id"

# Meta Graph API (Instagram)
META_APP_ID="tu_meta_app_id"
META_APP_SECRET="tu_meta_app_secret"

# Base de datos (Neon Postgres vía marketplace de Vercel) — social/QR/Bóveda,
# consentimiento, eventos del Índice, y el puente de login social. Ver
# src/db/schema.ts.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Login social (Fase A, hallazgo #4) — ver src/lib/social-auth/.
# Sin estas variables, los botones de Google/Apple simplemente no aparecen
# (no rompen nada) — ver /api/auth/social/providers.
NEXTAUTH_SECRET="genera-un-secreto-largo-y-aleatorio"   # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"                     # URL pública en producción

# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
# (tipo "Aplicación web"). Redirect URI autorizado:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Developer → Certificates, Identifiers & Profiles. Necesita un
# Services ID (APPLE_CLIENT_ID) + una Sign in with Apple Key (.p8, se
# descarga UNA vez). Redirect URI autorizado en el Services ID:
#   {NEXTAUTH_URL}/api/auth/callback/apple
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_CLIENT_ID=""
APPLE_PRIVATE_KEY=""   # contenido completo del archivo .p8 (con saltos de línea, o "\n" literales)

# Cifra la contraseña puente que el login social guarda para volver a
# autenticar contra Shopify (ver linked_accounts en src/db/schema.ts — la
# Admin API de Shopify no permite resetear contraseñas de un customer
# existente, y Multipass es exclusivo de Shopify Plus). OBLIGATORIA en
# producción — sin ella el login social falla explícitamente, nunca cae a
# una clave insegura. Generar con: openssl rand -base64 32
LINKED_ACCOUNT_ENCRYPTION_KEY=""

# Protege /api/cron/process-account-deletions (borrado de cuenta, Fase B —
# ver src/lib/account-deletion.ts). Configurar un Cron Job en Vercel que
# mande "Authorization: Bearer <este valor>" — Vercel ya hace esto solo
# para crons definidos en vercel.json, no hace falta nada especial.
# Generar con: openssl rand -base64 32
CRON_SECRET=""